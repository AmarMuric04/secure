{
	"name": "secure",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"lint": "turbo lint",
		"lint:fix": "turbo lint:fix",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"typecheck": "turbo typecheck",
		"validate": "turbo lint typecheck",
		"clean:all": "turbo run clean --parallel && rimraf node_modules .turbo .tanstack .cache dist",
		"sync:check": "syncpack list-mismatches",
		"sync:fix": "syncpack fix-mismatches",
		"sync:format": "syncpack format",
		"sync:list": "syncpack list"
	},
	"dependencies": {
		"turbo": "^2.5.6"
	},
	"devDependencies": {
		"eslint-config-base": "workspace:*",
		"typescript-config": "workspace:*",
		"globals": "^15.15.0",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"rimraf": "^5.0.5",
		"syncpack": "^13.0.4",
		"typescript": "~5.7.2"
	},
	"packageManager": "bun@1.2.0",
	"engines": {
		"node": ">=22"
	}
}
